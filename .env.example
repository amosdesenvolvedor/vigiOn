NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1

# Local Docker database. Replace every value in production.
MYSQL_DATABASE=vigioni
MYSQL_USER=vigioni
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root-local
DATABASE_URL=mysql://vigioni:change-me-local@localhost:3306/vigioni

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
APP_URL=http://localhost:5173
EMAIL_FROM=VigiOn <no-reply@vigion.cloud>
RESEND_API_KEY=

# Google OAuth / OpenID Connect. Keep disabled until real credentials are configured.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://vigion.cloud/api/v1/auth/oauth/google/callback

# Microsoft Identity Platform / OpenID Connect.
MICROSOFT_AUTH_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=

# Generate with: openssl rand -base64 32
CAMERA_CREDENTIAL_KEY=
# Independent AES-256-GCM key for TOTP secrets. Generate: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# Gateway protocol configuration (cloud API)
GATEWAY_PAIRING_TTL_MINUTES=10
GATEWAY_OFFLINE_TIMEOUT_SECONDS=120
GATEWAY_COMMAND_TTL_SECONDS=300
STREAM_SESSION_TTL_SECONDS=600
STREAM_IDLE_TIMEOUT_SECONDS=90
STREAM_START_TIMEOUT_SECONDS=45
MAX_ACTIVE_STREAMS_PER_ORG=10
STREAM_MEDIA_ROOT=/tmp/vigion-streams
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=vigion-media
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
MEDIA_ACCESS_TTL_SECONDS=300
SNAPSHOT_MAX_BYTES=5242880
RECORDING_MAX_BYTES=67108864
RECORDING_SEGMENT_SECONDS=60
RETENTION_INTERVAL_SECONDS=300
EVENT_TIMESTAMP_SKEW_SECONDS=3600
EVENT_METADATA_MAX_BYTES=4096
GATEWAY_RECONCILE_INTERVAL_SECONDS=30
NOTIFICATION_WORKER_INTERVAL_SECONDS=30
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_TTL_HOURS=24
EMAIL_COOLDOWN_SECONDS=900

# Generate once with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:security@vigion.cloud

# Billing remains disabled until test credentials and real commercial prices are configured.
BILLING_ENABLED=false
BILLING_ENVIRONMENT=test
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
FRONTEND_URL=http://localhost:5173
BILLING_RECONCILE_INTERVAL_SECONDS=900

# Edge agent installation (configure on the customer's local gateway, never on the cloud API)
VIGION_CLOUD_URL=https://vigion.cloud
VIGION_PAIRING_CODE=
VIGION_GATEWAY_NAME=Gateway principal
VIGION_GATEWAY_CONFIG=./gateway-config.json
VIGION_GATEWAY_QUEUE=./gateway-queue.json
VIGION_FFMPEG_PATH=ffmpeg
VIGION_MAX_STREAMS=4
VIGION_STREAM_START_TIMEOUT_SECONDS=30
VIGION_MEDIA_STAGING=./gateway-media
VIGION_MEDIA_STAGING_MAX_BYTES=536870912
VIGION_UPLOAD_MAX_ATTEMPTS=8
VIGION_UPLOAD_TTL_SECONDS=86400
VIGION_EVENT_QUEUE=./gateway-events.json
VIGION_EVENT_QUEUE_LIMIT=1000
VIGION_EVENT_TTL_SECONDS=86400
VIGION_MOTION_WIDTH=320
VIGION_MOTION_HEIGHT=180
VIGION_CAMERA_HEALTH_INTERVAL_SECONDS=30


# Vigion AI Support — Cloudflare Workers AI (secrets apenas no .env privado)
AI_ENABLED=false
AI_PROVIDER=cloudflare
AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
AI_DAILY_REQUEST_LIMIT=200
AI_USER_DAILY_REQUEST_LIMIT=10
AI_ORG_DAILY_REQUEST_LIMIT=30
AI_MAX_OUTPUT_TOKENS=384
AI_MAX_INPUT_CHARS=2000
AI_HISTORY_LIMIT=8
AI_REQUEST_TIMEOUT_MS=20000
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RESET_MS=60000
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
