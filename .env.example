NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1

# Local Docker database. Replace every value in production.
MYSQL_DATABASE=vigioni
MYSQL_USER=vigioni
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root-local
DATABASE_URL=mysql://vigioni:change-me-local@localhost:3306/vigioni

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24
