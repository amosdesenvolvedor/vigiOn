  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum PlatformUserRole {
  SUPER_ADMIN
  SUPPORT
  AUDITOR
}

enum PlatformRole {
  PLATFORM_ADMIN
}

enum ExternalIdentityProvider {
