  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  userId         String       @db.Char(36)
  endpoint       String       @db.Text
  endpointHash   String       @unique @db.Char(64)
  p256dh         String       @db.VarChar(255)
  auth           String       @db.VarChar(255)
  userAgent      String?      @db.VarChar(512)
  lastUsedAt     DateTime?    @db.DateTime(3)
  revokedAt      DateTime?    @db.DateTime(3)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, userId, revokedAt])
}

model Notification {
  id             String               @id @default(uuid()) @db.Char(36)
  organizationId String               @db.Char(36)
  userId         String               @db.Char(36)
  eventId        String?              @db.Char(36)
  alertId        String               @db.Char(36)
  channel        NotificationChannel  @default(IN_APP)
  title          String               @db.VarChar(180)
  message        String               @db.Text
  priority       NotificationPriority @default(NORMAL)
  status         NotificationStatus   @default(PENDING)
  readAt         DateTime?            @db.DateTime(3)
  sentAt         DateTime?            @db.DateTime(3)
  deliveredAt    DateTime?            @db.DateTime(3)
  attempts       Int                  @default(0)
  nextAttemptAt  DateTime?            @db.DateTime(3)
  expiresAt      DateTime?            @db.DateTime(3)
  errorCode      String?              @db.VarChar(64)
  createdAt      DateTime             @default(now()) @db.DateTime(3)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User                 @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  event          CameraEvent?         @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict)
  alert          Alert                @relation(fields: [organizationId, alertId], references: [organizationId, id], onDelete: Restrict)

  @@unique([alertId, userId, channel])
  @@index([organizationId, userId, status, createdAt])
  @@index([organizationId, userId, readAt, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, eventId])
  @@index([status, nextAttemptAt])
}

model StorageFile {
  id              String            @id @default(uuid()) @db.Char(36)
  organizationId  String            @db.Char(36)
  cameraId        String?           @db.Char(36)
  gatewayId       String?           @db.Char(36)
  requestedById   String?           @db.Char(36)
  idempotencyKey  String?           @db.Char(36)
  eventId         String?           @db.Char(36)
  type            StorageFileType
  status          StorageFileStatus @default(PENDING)
  storageProvider String            @db.VarChar(60)
  storageKey      String            @db.VarChar(768)
  fileName        String            @db.VarChar(255)
  mimeType        String            @db.VarChar(127)
  sizeBytes       BigInt            @default(0)
  reservedBytes   BigInt            @default(0)
  durationSeconds Int?
  checksum        String?           @db.VarChar(128)
  capturedAt      DateTime?         @db.DateTime(3)
  uploadedAt      DateTime?         @db.DateTime(3)
  deletedAt       DateTime?         @db.DateTime(3)
  errorCode       String?           @db.VarChar(64)
  createdAt       DateTime          @default(now()) @db.DateTime(3)
  expiresAt       DateTime?         @db.DateTime(3)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  camera          Camera?           @relation(fields: [organizationId, cameraId], references: [organizationId, id], onDelete: Restrict)
  gateway         Gateway?          @relation(fields: [organizationId, gatewayId], references: [organizationId, id], onDelete: Restrict)
  requestedBy     User?             @relation(fields: [organizationId, requestedById], references: [organizationId, id], onDelete: Restrict)
  event           CameraEvent?      @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict)

  @@unique([storageProvider, storageKey])
  @@unique([organizationId, requestedById, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, type, createdAt])
  @@index([organizationId, cameraId, createdAt])
  @@index([organizationId, gatewayId, status])
  @@index([status, expiresAt])
  @@index([organizationId, eventId])
  @@index([expiresAt])
}

model Plan {
  id                  String                   @id @default(uuid()) @db.Char(36)
  name                String                   @db.VarChar(100)
  slug                String                   @unique @db.VarChar(64)
  code                String                   @db.VarChar(32)
  version             Int                      @default(1)
  priceCents          Int?
  currency            String                   @default("BRL") @db.Char(3)
  billingInterval     PlanInterval             @default(MONTHLY)
  maxCameras          Int
  maxStorageBytes     BigInt
  retentionDays       Int
  maxUsers            Int
  trialDays           Int                      @default(0)
  isPublic            Boolean                  @default(true)
  enabledFeatures     Json
  status              PlanStatus               @default(ACTIVE)
  createdAt           DateTime                 @default(now()) @db.DateTime(3)
  updatedAt           DateTime                 @updatedAt @db.DateTime(3)
  subscriptions       Subscription[]
  subscriptionHistory SubscriptionHistory[]
  checkoutSessions    BillingCheckoutSession[]

  @@unique([code, version])
  @@index([status])
  @@index([code, status, isPublic])
}

model Subscription {
  id                     String                   @id @default(uuid()) @db.Char(36)
  organizationId         String                   @db.Char(36)
  planId                 String                   @db.Char(36)
  status                 SubscriptionStatus       @default(TRIALING)
  startedAt              DateTime                 @default(now()) @db.DateTime(3)
  currentPeriodStart     DateTime                 @db.DateTime(3)
  currentPeriodEnd       DateTime                 @db.DateTime(3)
  canceledAt             DateTime?                @db.DateTime(3)
  cancelAtPeriodEnd      Boolean                  @default(false)
  trialEndsAt            DateTime?                @db.DateTime(3)
  endedAt                DateTime?                @db.DateTime(3)
  billingProvider        BillingProvider?
  providerSubscriptionId String?                  @unique @db.VarChar(191)
  stripePriceId          String?                  @db.VarChar(191)
  createdAt              DateTime                 @default(now()) @db.DateTime(3)
  updatedAt              DateTime                 @updatedAt @db.DateTime(3)
  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan                   Plan                     @relation(fields: [planId], references: [id], onDelete: Restrict)
  history                SubscriptionHistory[]
  checkoutSessions       BillingCheckoutSession[]
  payments               Payment[]
  invoices               Invoice[]

  @@index([organizationId, status])
  @@index([organizationId, currentPeriodEnd])
  @@index([planId, status])
}

model BillingCheckoutSession {
  id                 String                @id @default(uuid()) @db.Char(36)
  organizationId     String                @db.Char(36)
  subscriptionId     String?               @db.Char(36)
  planId             String                @db.Char(36)
  requestedById      String                @db.Char(36)
  provider           BillingProvider       @default(MERCADO_PAGO)
  providerCheckoutId String?               @unique @db.VarChar(191)
  idempotencyKey     String                @db.Char(36)
  status             BillingCheckoutStatus @default(PENDING)
  amountCents        Int
  currency           String                @db.Char(3)
  checkoutUrl        String?               @db.VarChar(2048)
  expiresAt          DateTime              @db.DateTime(3)
  completedAt        DateTime?             @db.DateTime(3)
  errorCode          String?               @db.VarChar(64)
  activeLock         String?               @unique @db.Char(36)
  createdAt          DateTime              @default(now()) @db.DateTime(3)
  updatedAt          DateTime              @updatedAt @db.DateTime(3)
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription       Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  plan               Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments           Payment[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([status, expiresAt])
}

model Payment {
  id                String                  @id @default(uuid()) @db.Char(36)
  organizationId    String                  @db.Char(36)
  subscriptionId    String?                 @db.Char(36)
  invoiceId         String?                 @db.Char(36)
  checkoutSessionId String?                 @db.Char(36)
  provider          BillingProvider         @default(MERCADO_PAGO)
  providerPaymentId String                  @unique @db.VarChar(191)
  status            PaymentStatus           @default(PENDING)
  amountCents       Int
  currency          String                  @db.Char(3)
  paymentMethod     PaymentMethod           @default(UNKNOWN)
  description       String?                 @db.VarChar(255)
  paidAt            DateTime?               @db.DateTime(3)
  failedAt          DateTime?               @db.DateTime(3)
  createdAt         DateTime                @default(now()) @db.DateTime(3)
  updatedAt         DateTime                @updatedAt @db.DateTime(3)
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription      Subscription?           @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  invoice           Invoice?                @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  checkoutSession   BillingCheckoutSession? @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([status, createdAt])
}

model Invoice {
  id                String          @id @default(uuid()) @db.Char(36)
  organizationId    String          @db.Char(36)
  subscriptionId    String?         @db.Char(36)
  provider          BillingProvider @default(MERCADO_PAGO)
  providerInvoiceId String?         @unique @db.VarChar(191)
  status            InvoiceStatus   @default(OPEN)
  amountCents       Int
  currency          String          @db.Char(3)
  periodStart       DateTime        @db.DateTime(3)
  periodEnd         DateTime        @db.DateTime(3)
  dueAt             DateTime?       @db.DateTime(3)
  paidAt            DateTime?       @db.DateTime(3)
  createdAt         DateTime        @default(now()) @db.DateTime(3)
  updatedAt         DateTime        @updatedAt @db.DateTime(3)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription      Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  payments          Payment[]

  @@index([organizationId, createdAt])
  @@index([subscriptionId, createdAt])
  @@index([status, createdAt])
}

model BillingWebhookEvent {
