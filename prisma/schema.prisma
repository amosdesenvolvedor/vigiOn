enum StreamSessionStatus {
  REQUESTED
  STARTING
  ACTIVE
  STOPPING
  ENDED
  FAILED
  EXPIRED
}

model Organization {
  id                      String                         @id @default(uuid()) @db.Char(36)
  name                    String                         @db.VarChar(160)
  slug                    String                         @unique @db.VarChar(100)
  status                  OrganizationStatus             @default(ACTIVE)
  timezone                String                         @default("UTC") @db.VarChar(64)
  deletedAt               DateTime?                      @db.DateTime(3)
  createdAt               DateTime                       @default(now()) @db.DateTime(3)
  updatedAt               DateTime                       @updatedAt @db.DateTime(3)
  stripeCustomerId        String?                        @unique @db.VarChar(191)
  customer                CustomerProfile?
  users                   User[]
  memberships             OrganizationMembership[]
  invitations             OrganizationInvitation[]
  settings                OrganizationSettings?
  cameras                 Camera[]
  cameraIdentifiers       CameraIdentifier[]
  gateways                Gateway[]
  gatewayPairingCodes     GatewayPairingCode[]
  gatewayCommands         GatewayCommand[]
  gatewayMessages         GatewayMessage[]
  streamSessions          StreamSession[]
  events                  CameraEvent[]
  notifications           Notification[]
  alerts                  Alert[]
  notificationPreferences NotificationPreference[]
  storageFiles            StorageFile[]
  subscriptions           Subscription[]
  subscriptionHistory     SubscriptionHistory[]
  storageUsage            StorageUsage?
  resourceCounter         ResourceCounter?
  limitEvents             LimitEvent[]
  auditLogs               AuditLog[]
  monitoringSchedules     MonitoringSchedule[]
  scheduleExceptions      ScheduleException[]
  cameraZones             CameraZone[]
  eventClassifications    EventClassification[]
  pushSubscriptions       PushSubscription[]
  billingCheckoutSessions BillingCheckoutSession[]
  payments                Payment[]
  invoices                Invoice[]
  discoverySessions       CameraDiscoverySession[]
  discoveryCandidates     CameraDiscoveryCandidate[]
  verificationSessions    CameraVerificationSession[]
  verificationCredentials CameraVerificationCredential[]
  aiConversations         AiConversation[]
  aiUsageDays             AiUsageDay[]

  @@index([status, deletedAt])
}

model CustomerProfile {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @unique @db.Char(36)
  legalName      String?      @db.VarChar(180)
  taxId          String?      @db.VarChar(40)
  contactEmail   String?      @db.VarChar(254)
  contactPhone   String?      @db.VarChar(32)
  metadata       Json?
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model User {
  id                      String                      @id @default(uuid()) @db.Char(36)
  organizationId          String                      @db.Char(36)
  name                    String                      @db.VarChar(160)
  email                   String                      @db.VarChar(254)
  normalizedEmail         String                      @unique @db.VarChar(254)
  passwordHash            String                      @db.VarChar(255)
  role                    UserRole                    @default(VIEWER)
  platformRole            PlatformRole?
  status                  UserStatus                  @default(INVITED)
  timezone                String?                     @db.VarChar(64)
  lastLoginAt             DateTime?                   @db.DateTime(3)
  emailVerifiedAt         DateTime?                   @db.DateTime(3)
  deletedAt               DateTime?                   @db.DateTime(3)
  createdAt               DateTime                    @default(now()) @db.DateTime(3)
  updatedAt               DateTime                    @updatedAt @db.DateTime(3)
  organization            Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  notifications           Notification[]
  acknowledgedAlerts      Alert[]                     @relation("AlertAcknowledgedBy")
  notificationPreferences NotificationPreference[]
  auditLogs               AuditLog[]
  sessions                Session[]
  oneTimeTokens           OneTimeToken[]
  memberships             OrganizationMembership[]
  streamSessions          StreamSession[]
  storageFiles            StorageFile[]
  sentInvitations         OrganizationInvitation[]    @relation("InvitationSender")
  pushSubscriptions       PushSubscription[]
  platformAuditLogs       PlatformAuditLog[]          @relation("PlatformAuditActor")
  mfaCredential           MfaCredential?
  mfaRecoveryCodes        MfaRecoveryCode[]
  externalIdentities      ExternalIdentity[]
  discoverySessions       CameraDiscoverySession[]
  verificationSessions    CameraVerificationSession[]
  aiConversations         AiConversation[]

  @@unique([organizationId, id])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, role])
}

model ExternalIdentity {
  id              String                   @id @default(uuid()) @db.Char(36)
  userId          String                   @db.Char(36)
  provider        ExternalIdentityProvider
  providerSubject String                   @db.VarChar(191)
  email           String                   @db.VarChar(254)
  emailVerified   Boolean                  @default(false)
  createdAt       DateTime                 @default(now()) @db.DateTime(3)
  updatedAt       DateTime                 @updatedAt @db.DateTime(3)
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId, provider])
  @@index([email])
}

model OAuthTransaction {
  id                  String                   @id @default(uuid()) @db.Char(36)
  provider            ExternalIdentityProvider
  stateHash           String                   @unique @db.Char(64)
  pkceVerifier        String                   @db.VarChar(128)
  nonce               String                   @db.VarChar(128)
  returnTo            String                   @db.VarChar(255)
  expiresAt           DateTime                 @db.DateTime(3)
  usedAt              DateTime?                @db.DateTime(3)
  completionPurpose   OAuthCompletionPurpose?
  completionTokenHash String?                  @unique @db.Char(64)
  providerSubject     String?                  @db.VarChar(191)
  email               String?                  @db.VarChar(254)
  emailVerified       Boolean?
  displayName         String?                  @db.VarChar(160)
  completedAt         DateTime?                @db.DateTime(3)
  createdAt           DateTime                 @default(now()) @db.DateTime(3)
  updatedAt           DateTime                 @updatedAt @db.DateTime(3)

  @@index([provider, expiresAt, usedAt])
  @@index([expiresAt, completedAt])
}

model MfaCredential {
  id              String    @id @default(uuid()) @db.Char(36)
  userId          String    @unique @db.Char(36)
  encryptedSecret String    @db.Text
  enabledAt       DateTime? @db.DateTime(3)
  lastUsedStep    BigInt?
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabledAt])
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @db.Char(36)
  codeHash  String    @unique @db.Char(64)
  usedAt    DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Char(36)
  userId         String           @db.Char(36)
  organizationId String           @db.Char(36)
  role           UserRole         @default(VIEWER)
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now()) @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @db.DateTime(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId, status, role])
  @@index([userId, status])
}

model OrganizationInvitation {
  id              String           @id @default(uuid()) @db.Char(36)
  organizationId  String           @db.Char(36)
  email           String           @db.VarChar(254)
  normalizedEmail String           @db.VarChar(254)
  role            UserRole
  status          InvitationStatus @default(PENDING)
  tokenHash       String           @unique @db.Char(64)
  expiresAt       DateTime         @db.DateTime(3)
  acceptedAt      DateTime?        @db.DateTime(3)
  canceledAt      DateTime?        @db.DateTime(3)
  invitedById     String           @db.Char(36)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @db.DateTime(3)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy       User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([normalizedEmail, status])
}

model OrganizationSettings {
  id                      String       @id @default(uuid()) @db.Char(36)
  organizationId          String       @unique @db.Char(36)
  language                String       @default("pt-BR") @db.VarChar(16)
  country                 String       @default("BR") @db.Char(2)
  tradeName               String?      @db.VarChar(180)
  contactEmail            String?      @db.VarChar(254)
  contactPhone            String?      @db.VarChar(32)
  monitoringPreferences   Json?
  notificationPreferences Json?
  createdAt               DateTime     @default(now()) @db.DateTime(3)
  updatedAt               DateTime     @updatedAt @db.DateTime(3)
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Session {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @db.Char(36)
  userId         String    @db.Char(36)
  familyId       String    @db.Char(36)
  tokenHash      String    @unique @db.Char(64)
  expiresAt      DateTime  @db.DateTime(3)
  revokedAt      DateTime? @db.DateTime(3)
  lastUsedAt     DateTime? @db.DateTime(3)
  mfaVerifiedAt  DateTime? @db.DateTime(3)
  replacedById   String?   @db.Char(36)
  ipAddress      String?   @db.VarChar(45)
  userAgent      String?   @db.VarChar(512)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, revokedAt, expiresAt])
  @@index([familyId])
  @@index([expiresAt])
}

model OneTimeToken {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @db.Char(36)
  userId         String           @db.Char(36)
  type           OneTimeTokenType
  tokenHash      String           @unique @db.Char(64)
  expiresAt      DateTime         @db.DateTime(3)
  usedAt         DateTime?        @db.DateTime(3)
  createdAt      DateTime         @default(now()) @db.DateTime(3)
  user           User             @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, userId, type, usedAt])
  @@index([expiresAt])
}

model PlatformUser {
  id              String           @id @default(uuid()) @db.Char(36)
  name            String           @db.VarChar(160)
  email           String           @db.VarChar(254)
  normalizedEmail String           @unique @db.VarChar(254)
  passwordHash    String           @db.VarChar(255)
  role            PlatformUserRole @default(SUPPORT)
  active          Boolean          @default(true)
  lastLoginAt     DateTime?        @db.DateTime(3)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @db.DateTime(3)
}

model Camera {
  id                          String                     @id @default(uuid()) @db.Char(36)
  organizationId              String                     @db.Char(36)
  gatewayId                   String?                    @db.Char(36)
  catalogVariantId            String?                    @db.Char(36)
  verificationSessionId       String?                    @unique @db.Char(36)
  creationSource              CameraCreationSource       @default(MANUAL)
  detectedCapabilities        Json?
  capabilityEvidence          Json?
  name                        String                     @db.VarChar(160)
  description                 String?                    @db.Text
  location                    String?                    @db.VarChar(255)
  administrativeStatus        CameraAdministrativeStatus @default(ACTIVE)
  connectionStatus            CameraConnectionStatus     @default(UNKNOWN)
  connectionType              CameraConnectionType       @default(OTHER)
  protocol                    CameraProtocol
  manufacturer                String?                    @db.VarChar(100)
  model                       String?                    @db.VarChar(100)
  identifier                  String?                    @db.VarChar(191)
  lastSeenAt                  DateTime?                  @db.DateTime(3)
  lastHealthCheckAt           DateTime?                  @db.DateTime(3)
  lastSuccessfulHealthCheckAt DateTime?                  @db.DateTime(3)
  consecutiveFailures         Int                        @default(0)
  healthSequence              BigInt                     @default(0)
  healthGeneration            Int                        @default(1)
  healthFailureCode           String?                    @db.VarChar(64)
  healthProfile               Json?
  currentNetworkAddress       String?                    @db.VarChar(45)
  currentServicePort          Int?
  motionEnabled               Boolean                    @default(false)
  motionSensitivity           String                     @default("MEDIUM") @db.VarChar(16)
  motionSampleFps             Int                        @default(2)
  motionCooldownSeconds       Int                        @default(10)
  captureSnapshotOnMotion     Boolean                    @default(false)
  deletedAt                   DateTime?                  @db.DateTime(3)
  createdAt                   DateTime                   @default(now()) @db.DateTime(3)
  updatedAt                   DateTime                   @updatedAt @db.DateTime(3)
  organization                Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gateway                     Gateway?                   @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  catalogVariant              CameraCatalogVariant?      @relation(fields: [catalogVariantId], references: [id], onDelete: SetNull)
  verificationSession         CameraVerificationSession? @relation(fields: [verificationSessionId], references: [id], onDelete: SetNull)
  credential                  CameraCredential?
  identifiers                 CameraIdentifier[]
  events                      CameraEvent[]
  storageFiles                StorageFile[]
  streamSessions              StreamSession[]
  monitoringSchedules         MonitoringSchedule[]
  cameraZones                 CameraZone[]

  @@unique([organizationId, id])
  @@unique([organizationId, identifier])
  @@index([organizationId, administrativeStatus, deletedAt])
  @@index([organizationId, connectionStatus, deletedAt])
  @@index([organizationId, lastSeenAt])
  @@index([organizationId, gatewayId, deletedAt])
  @@index([catalogVariantId])
}

model CameraIdentifier {
  id             String               @id @default(uuid()) @db.Char(36)
  organizationId String               @db.Char(36)
  cameraId       String               @db.Char(36)
  type           CameraIdentifierType
  valueHash      String               @db.Char(64)
  createdAt      DateTime             @default(now()) @db.DateTime(3)
  camera         Camera               @relation(fields: [organizationId, cameraId], references: [organizationId, id], onDelete: Cascade)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, type, valueHash])
  @@index([organizationId, cameraId])
}

model CameraCatalogManufacturer {
  id             String                @id @default(uuid()) @db.Char(36)
  name           String                @db.VarChar(120)
  normalizedName String                @unique @db.VarChar(120)
  notes          String?               @db.Text
  createdAt      DateTime              @default(now()) @db.DateTime(3)
  updatedAt      DateTime              @updatedAt @db.DateTime(3)
  brands         CameraCatalogBrand[]
  sources        CameraCatalogSource[]

  @@index([name])
}

model CameraCatalogBrand {
  id             String                    @id @default(uuid()) @db.Char(36)
  manufacturerId String                    @db.Char(36)
  name           String                    @db.VarChar(120)
  normalizedName String                    @db.VarChar(120)
  createdAt      DateTime                  @default(now()) @db.DateTime(3)
  updatedAt      DateTime                  @updatedAt @db.DateTime(3)
  manufacturer   CameraCatalogManufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  families       CameraCatalogFamily[]
  models         CameraCatalogModel[]

  @@unique([manufacturerId, normalizedName])
  @@index([name])
}

model CameraCatalogFamily {
  id             String               @id @default(uuid()) @db.Char(36)
  brandId        String               @db.Char(36)
  name           String               @db.VarChar(120)
  normalizedName String               @db.VarChar(120)
  createdAt      DateTime             @default(now()) @db.DateTime(3)
  updatedAt      DateTime             @updatedAt @db.DateTime(3)
  brand          CameraCatalogBrand   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  models         CameraCatalogModel[]

  @@unique([brandId, normalizedName])
  @@index([name])
}

model CameraCatalogModel {
  id             String                 @id @default(uuid()) @db.Char(36)
  brandId        String                 @db.Char(36)
  familyId       String?                @db.Char(36)
  name           String                 @db.VarChar(160)
  normalizedName String                 @db.VarChar(160)
  aliases        Json?
  cameraType     CatalogCameraType      @default(UNKNOWN)
  resolution     String?                @db.VarChar(80)
  notes          String?                @db.Text
  createdAt      DateTime               @default(now()) @db.DateTime(3)
  updatedAt      DateTime               @updatedAt @db.DateTime(3)
