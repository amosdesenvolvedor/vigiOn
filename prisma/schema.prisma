generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CANCELED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELED
  EXPIRED
}

enum UserRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum PlatformUserRole {
  SUPER_ADMIN
  SUPPORT
  AUDITOR
}

enum CameraAdministrativeStatus {
  ACTIVE
  DISABLED
}

enum CameraConnectionStatus {
  UNKNOWN
  CONNECTING
  ONLINE
  OFFLINE
  ERROR
}

enum CameraConnectionType {
  WIFI
  ETHERNET
  OTHER
}

enum CameraProtocol {
  RTSP
  ONVIF
  HTTP
  HTTPS
  PROPRIETARY
  OTHER
}

enum EventSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum EventStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum CameraEventType {
  MOTION
  CAMERA_OFFLINE
  CAMERA_ONLINE
  GATEWAY_OFFLINE
  GATEWAY_ONLINE
}

enum CameraEventSource {
  MOTION_DETECTOR
  CONNECTIVITY_MONITOR
  GATEWAY_MONITOR
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum StorageFileType {
  IMAGE
  SNAPSHOT
  VIDEO
  RECORDING
  EVENT_EVIDENCE
  OTHER
}

enum StorageFileStatus {
  PENDING
  CAPTURING
  UPLOADING
  AVAILABLE
  FAILED
  DELETING
  DELETED
  EXPIRED
}

enum PlanInterval {
  MONTHLY
  YEARLY
  CUSTOM
}

enum PlanStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  SUSPENDED
}

enum OneTimeTokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum GatewayStatus {
  ONLINE
  OFFLINE
  CONNECTING
  DISABLED
  UNKNOWN
}

enum GatewayPairingStatus {
  PENDING
  USED
  REVOKED
  EXPIRED
}

enum GatewayCommandType {
  GET_CAMERA_STATUS
  TEST_CAMERA
  START_STREAM
  STOP_STREAM
  STREAM_STATUS
  CAPTURE_SNAPSHOT
  START_RECORDING
  STOP_RECORDING
}

enum GatewayCommandStatus {
  PENDING
  DELIVERED
  SUCCEEDED
  FAILED
  EXPIRED
}

enum StreamSessionStatus {
  REQUESTED
  STARTING
  ACTIVE
  STOPPING
  ENDED
  FAILED
  EXPIRED
}

model Organization {
  id                  String                   @id @default(uuid()) @db.Char(36)
  name                String                   @db.VarChar(160)
  slug                String                   @unique @db.VarChar(100)
  status              OrganizationStatus       @default(ACTIVE)
  timezone            String                   @default("UTC") @db.VarChar(64)
  deletedAt           DateTime?                @db.DateTime(3)
  createdAt           DateTime                 @default(now()) @db.DateTime(3)
  updatedAt           DateTime                 @updatedAt @db.DateTime(3)
  customer            CustomerProfile?
  users               User[]
  memberships         OrganizationMembership[]
  invitations         OrganizationInvitation[]
  settings            OrganizationSettings?
  cameras             Camera[]
  gateways            Gateway[]
  gatewayPairingCodes GatewayPairingCode[]
  gatewayCommands     GatewayCommand[]
  gatewayMessages     GatewayMessage[]
  streamSessions      StreamSession[]
  events              CameraEvent[]
  notifications       Notification[]
  storageFiles        StorageFile[]
  subscriptions       Subscription[]
  subscriptionHistory SubscriptionHistory[]
  storageUsage        StorageUsage?
  resourceCounter     ResourceCounter?
  limitEvents         LimitEvent[]
  auditLogs           AuditLog[]

  @@index([status, deletedAt])
}

model CustomerProfile {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @unique @db.Char(36)
  legalName      String?      @db.VarChar(180)
  taxId          String?      @db.VarChar(40)
  contactEmail   String?      @db.VarChar(254)
  contactPhone   String?      @db.VarChar(32)
  metadata       Json?
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model User {
  id              String                   @id @default(uuid()) @db.Char(36)
  organizationId  String                   @db.Char(36)
  name            String                   @db.VarChar(160)
  email           String                   @db.VarChar(254)
  normalizedEmail String                   @unique @db.VarChar(254)
  passwordHash    String                   @db.VarChar(255)
  role            UserRole                 @default(VIEWER)
  status          UserStatus               @default(INVITED)
  timezone        String?                  @db.VarChar(64)
  lastLoginAt     DateTime?                @db.DateTime(3)
  emailVerifiedAt DateTime?                @db.DateTime(3)
  deletedAt       DateTime?                @db.DateTime(3)
  createdAt       DateTime                 @default(now()) @db.DateTime(3)
  updatedAt       DateTime                 @updatedAt @db.DateTime(3)
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  notifications   Notification[]
  auditLogs       AuditLog[]
  sessions        Session[]
  oneTimeTokens   OneTimeToken[]
  memberships     OrganizationMembership[]
  streamSessions  StreamSession[]
  storageFiles    StorageFile[]
  sentInvitations OrganizationInvitation[] @relation("InvitationSender")

  @@unique([organizationId, id])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, role])
}

model OrganizationMembership {
  id             String           @id @default(uuid()) @db.Char(36)
  userId         String           @db.Char(36)
  organizationId String           @db.Char(36)
  role           UserRole         @default(VIEWER)
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now()) @db.DateTime(3)
  updatedAt      DateTime         @updatedAt @db.DateTime(3)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId, status, role])
  @@index([userId, status])
}

model OrganizationInvitation {
  id              String           @id @default(uuid()) @db.Char(36)
  organizationId  String           @db.Char(36)
  email           String           @db.VarChar(254)
  normalizedEmail String           @db.VarChar(254)
  role            UserRole
  status          InvitationStatus @default(PENDING)
  tokenHash       String           @unique @db.Char(64)
  expiresAt       DateTime         @db.DateTime(3)
  acceptedAt      DateTime?        @db.DateTime(3)
  canceledAt      DateTime?        @db.DateTime(3)
  invitedById     String           @db.Char(36)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @db.DateTime(3)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitedBy       User             @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status, createdAt])
  @@index([normalizedEmail, status])
}

model OrganizationSettings {
  id                      String       @id @default(uuid()) @db.Char(36)
  organizationId          String       @unique @db.Char(36)
  language                String       @default("pt-BR") @db.VarChar(16)
  country                 String       @default("BR") @db.Char(2)
  tradeName               String?      @db.VarChar(180)
  contactEmail            String?      @db.VarChar(254)
  contactPhone            String?      @db.VarChar(32)
  monitoringPreferences   Json?
  notificationPreferences Json?
  createdAt               DateTime     @default(now()) @db.DateTime(3)
  updatedAt               DateTime     @updatedAt @db.DateTime(3)
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Session {
  id             String    @id @default(uuid()) @db.Char(36)
  organizationId String    @db.Char(36)
  userId         String    @db.Char(36)
  familyId       String    @db.Char(36)
  tokenHash      String    @unique @db.Char(64)
  expiresAt      DateTime  @db.DateTime(3)
  revokedAt      DateTime? @db.DateTime(3)
  lastUsedAt     DateTime? @db.DateTime(3)
  replacedById   String?   @db.Char(36)
  ipAddress      String?   @db.VarChar(45)
  userAgent      String?   @db.VarChar(512)
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, revokedAt, expiresAt])
  @@index([familyId])
  @@index([expiresAt])
}

model OneTimeToken {
  id             String           @id @default(uuid()) @db.Char(36)
  organizationId String           @db.Char(36)
  userId         String           @db.Char(36)
  type           OneTimeTokenType
  tokenHash      String           @unique @db.Char(64)
  expiresAt      DateTime         @db.DateTime(3)
  usedAt         DateTime?        @db.DateTime(3)
  createdAt      DateTime         @default(now()) @db.DateTime(3)
  user           User             @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade)

  @@index([organizationId, userId, type, usedAt])
  @@index([expiresAt])
}

model PlatformUser {
  id              String           @id @default(uuid()) @db.Char(36)
  name            String           @db.VarChar(160)
  email           String           @db.VarChar(254)
  normalizedEmail String           @unique @db.VarChar(254)
  passwordHash    String           @db.VarChar(255)
  role            PlatformUserRole @default(SUPPORT)
  active          Boolean          @default(true)
  lastLoginAt     DateTime?        @db.DateTime(3)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @db.DateTime(3)
}

model Camera {
  id                      String                     @id @default(uuid()) @db.Char(36)
  organizationId          String                     @db.Char(36)
  gatewayId               String?                    @db.Char(36)
  name                    String                     @db.VarChar(160)
  description             String?                    @db.Text
  location                String?                    @db.VarChar(255)
  administrativeStatus    CameraAdministrativeStatus @default(ACTIVE)
  connectionStatus        CameraConnectionStatus     @default(UNKNOWN)
  connectionType          CameraConnectionType       @default(OTHER)
  protocol                CameraProtocol
  manufacturer            String?                    @db.VarChar(100)
  model                   String?                    @db.VarChar(100)
  identifier              String?                    @db.VarChar(191)
  lastSeenAt              DateTime?                  @db.DateTime(3)
  motionEnabled           Boolean                    @default(false)
  motionSensitivity       String                     @default("MEDIUM") @db.VarChar(16)
  motionSampleFps         Int                        @default(2)
  motionCooldownSeconds   Int                        @default(10)
  captureSnapshotOnMotion Boolean                    @default(false)
  deletedAt               DateTime?                  @db.DateTime(3)
  createdAt               DateTime                   @default(now()) @db.DateTime(3)
  updatedAt               DateTime                   @updatedAt @db.DateTime(3)
  organization            Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gateway                 Gateway?                   @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  credential              CameraCredential?
  events                  CameraEvent[]
  storageFiles            StorageFile[]
  streamSessions          StreamSession[]

  @@unique([organizationId, id])
  @@unique([organizationId, identifier])
  @@index([organizationId, administrativeStatus, deletedAt])
  @@index([organizationId, connectionStatus, deletedAt])
  @@index([organizationId, lastSeenAt])
  @@index([organizationId, gatewayId, deletedAt])
}

model Gateway {
  id                  String               @id @default(uuid()) @db.Char(36)
  organizationId      String               @db.Char(36)
  name                String               @db.VarChar(160)
  deviceId            String               @unique @db.Char(36)
  secretHash          String               @db.VarChar(255)
  encryptionPublicKey String?              @db.Text
  status              GatewayStatus        @default(UNKNOWN)
  version             String?              @db.VarChar(40)
  protocolVersion     String               @default("1") @db.VarChar(16)
  lastSeenAt          DateTime?            @db.DateTime(3)
  lastUptime          Int?
  disabledAt          DateTime?            @db.DateTime(3)
  deletedAt           DateTime?            @db.DateTime(3)
  createdAt           DateTime             @default(now()) @db.DateTime(3)
  updatedAt           DateTime             @updatedAt @db.DateTime(3)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cameras             Camera[]
  commands            GatewayCommand[]
  messages            GatewayMessage[]
  pairingCodes        GatewayPairingCode[]
  streamSessions      StreamSession[]
  storageFiles        StorageFile[]
  events              CameraEvent[]

  @@unique([organizationId, id])
  @@index([organizationId, status, deletedAt])
  @@index([organizationId, lastSeenAt])
}

model GatewayPairingCode {
  id             String               @id @default(uuid()) @db.Char(36)
  organizationId String               @db.Char(36)
  gatewayId      String?              @db.Char(36)
  codeHash       String               @unique @db.Char(64)
  status         GatewayPairingStatus @default(PENDING)
  expiresAt      DateTime             @db.DateTime(3)
  usedAt         DateTime?            @db.DateTime(3)
  createdById    String               @db.Char(36)
  createdAt      DateTime             @default(now()) @db.DateTime(3)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gateway        Gateway?             @relation(fields: [organizationId, gatewayId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, status, expiresAt])
  @@index([createdById, createdAt])
}

model GatewayCommand {
  id              String               @id @default(uuid()) @db.Char(36)
  organizationId  String               @db.Char(36)
  gatewayId       String               @db.Char(36)
  cameraId        String?              @db.Char(36)
  streamSessionId String?              @db.Char(36)
  commandId       String               @unique @db.Char(36)
  type            GatewayCommandType
  status          GatewayCommandStatus @default(PENDING)
  payload         Json?
  result          Json?
  deliveredAt     DateTime?            @db.DateTime(3)
  completedAt     DateTime?            @db.DateTime(3)
  expiresAt       DateTime             @db.DateTime(3)
  createdAt       DateTime             @default(now()) @db.DateTime(3)
  updatedAt       DateTime             @updatedAt @db.DateTime(3)
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gateway         Gateway              @relation(fields: [organizationId, gatewayId], references: [organizationId, id], onDelete: Restrict)
  streamSession   StreamSession?       @relation(fields: [organizationId, streamSessionId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, gatewayId, status, createdAt])
  @@index([organizationId, cameraId, createdAt])
  @@index([organizationId, streamSessionId, createdAt])
  @@index([expiresAt, status])
}

model StreamSession {
  id             String              @id @default(uuid()) @db.Char(36)
  organizationId String              @db.Char(36)
  cameraId       String              @db.Char(36)
  gatewayId      String              @db.Char(36)
  userId         String              @db.Char(36)
  idempotencyKey String              @db.Char(36)
  tokenHash      String              @db.Char(64)
  status         StreamSessionStatus @default(REQUESTED)
  startedAt      DateTime?           @db.DateTime(3)
  lastActivityAt DateTime            @default(now()) @db.DateTime(3)
  expiresAt      DateTime            @db.DateTime(3)
  endedAt        DateTime?           @db.DateTime(3)
  errorCode      String?             @db.VarChar(64)
  createdAt      DateTime            @default(now()) @db.DateTime(3)
  updatedAt      DateTime            @updatedAt @db.DateTime(3)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  camera         Camera              @relation(fields: [organizationId, cameraId], references: [organizationId, id], onDelete: Restrict)
  gateway        Gateway             @relation(fields: [organizationId, gatewayId], references: [organizationId, id], onDelete: Restrict)
  user           User                @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  commands       GatewayCommand[]

  @@unique([organizationId, id])
  @@unique([organizationId, userId, idempotencyKey])
  @@index([organizationId, cameraId, status])
  @@index([organizationId, gatewayId, status])
  @@index([userId, status, expiresAt])
  @@index([status, expiresAt])
}

model GatewayMessage {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  gatewayId      String       @db.Char(36)
  messageId      String       @db.Char(36)
  type           String       @db.VarChar(80)
  receivedAt     DateTime     @default(now()) @db.DateTime(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gateway        Gateway      @relation(fields: [organizationId, gatewayId], references: [organizationId, id], onDelete: Restrict)

  @@unique([gatewayId, messageId])
  @@index([organizationId, receivedAt])
}

model CameraCredential {
  id                   String   @id @default(uuid()) @db.Char(36)
  organizationId       String   @db.Char(36)
  cameraId             String   @unique @db.Char(36)
  ciphertext           Bytes    @db.LongBlob
  initializationVector Bytes    @db.VarBinary(32)
  authenticationTag    Bytes    @db.VarBinary(32)
  keyVersion           Int      @default(1)
  createdAt            DateTime @default(now()) @db.DateTime(3)
  updatedAt            DateTime @updatedAt @db.DateTime(3)
  camera               Camera   @relation(fields: [organizationId, cameraId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, cameraId])
  @@index([organizationId])
}

model CameraEvent {
  id              String            @id @default(uuid()) @db.Char(36)
  organizationId  String            @db.Char(36)
  cameraId        String?           @db.Char(36)
  gatewayId       String?           @db.Char(36)
  externalEventId String?           @db.Char(36)
  type            CameraEventType
  source          CameraEventSource
  severity        EventSeverity     @default(INFO)
  status          EventStatus       @default(OPEN)
  occurredAt      DateTime          @db.DateTime(3)
  endedAt         DateTime?         @db.DateTime(3)
  receivedAt      DateTime          @default(now()) @db.DateTime(3)
  acknowledgedAt  DateTime?         @db.DateTime(3)
  resolvedAt      DateTime?         @db.DateTime(3)
  metadata        Json?
  createdAt       DateTime          @default(now()) @db.DateTime(3)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  camera          Camera?           @relation(fields: [organizationId, cameraId], references: [organizationId, id], onDelete: Restrict)
  gateway         Gateway?          @relation(fields: [organizationId, gatewayId], references: [organizationId, id], onDelete: Restrict)
  notifications   Notification[]
  storageFiles    StorageFile[]

  @@unique([organizationId, id])
  @@unique([gatewayId, externalEventId])
  @@index([organizationId, occurredAt])
  @@index([organizationId, status, severity, occurredAt])
  @@index([organizationId, cameraId, occurredAt])
  @@index([organizationId, gatewayId, occurredAt])
  @@index([organizationId, type, occurredAt])
}

model Notification {
  id             String               @id @default(uuid()) @db.Char(36)
  organizationId String               @db.Char(36)
  userId         String               @db.Char(36)
  eventId        String?              @db.Char(36)
  channel        NotificationChannel  @default(IN_APP)
  title          String               @db.VarChar(180)
  message        String               @db.Text
  priority       NotificationPriority @default(NORMAL)
  status         NotificationStatus   @default(PENDING)
  readAt         DateTime?            @db.DateTime(3)
  sentAt         DateTime?            @db.DateTime(3)
  createdAt      DateTime             @default(now()) @db.DateTime(3)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User                 @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  event          CameraEvent?         @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, userId, status, createdAt])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, eventId])
}

model StorageFile {
  id              String            @id @default(uuid()) @db.Char(36)
  organizationId  String            @db.Char(36)
  cameraId        String?           @db.Char(36)
  gatewayId       String?           @db.Char(36)
  requestedById   String?           @db.Char(36)
  idempotencyKey  String?           @db.Char(36)
  eventId         String?           @db.Char(36)
  type            StorageFileType
  status          StorageFileStatus @default(PENDING)
  storageProvider String            @db.VarChar(60)
  storageKey      String            @db.VarChar(768)
  fileName        String            @db.VarChar(255)
  mimeType        String            @db.VarChar(127)
  sizeBytes       BigInt            @default(0)
  reservedBytes   BigInt            @default(0)
  durationSeconds Int?
  checksum        String?           @db.VarChar(128)
  capturedAt      DateTime?         @db.DateTime(3)
  uploadedAt      DateTime?         @db.DateTime(3)
  deletedAt       DateTime?         @db.DateTime(3)
  errorCode       String?           @db.VarChar(64)
  createdAt       DateTime          @default(now()) @db.DateTime(3)
  expiresAt       DateTime?         @db.DateTime(3)
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  camera          Camera?           @relation(fields: [organizationId, cameraId], references: [organizationId, id], onDelete: Restrict)
  gateway         Gateway?          @relation(fields: [organizationId, gatewayId], references: [organizationId, id], onDelete: Restrict)
  requestedBy     User?             @relation(fields: [organizationId, requestedById], references: [organizationId, id], onDelete: Restrict)
  event           CameraEvent?      @relation(fields: [organizationId, eventId], references: [organizationId, id], onDelete: Restrict)

  @@unique([storageProvider, storageKey])
  @@unique([organizationId, requestedById, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, type, createdAt])
  @@index([organizationId, cameraId, createdAt])
  @@index([organizationId, gatewayId, status])
  @@index([status, expiresAt])
  @@index([organizationId, eventId])
  @@index([expiresAt])
}

model Plan {
  id                  String                @id @default(uuid()) @db.Char(36)
  name                String                @db.VarChar(100)
  slug                String                @unique @db.VarChar(64)
  code                String                @db.VarChar(32)
  version             Int                   @default(1)
  priceCents          Int?
  currency            String                @default("BRL") @db.Char(3)
  billingInterval     PlanInterval          @default(MONTHLY)
  maxCameras          Int
  maxStorageBytes     BigInt
  retentionDays       Int
  maxUsers            Int
  trialDays           Int                   @default(0)
  isPublic            Boolean               @default(true)
  enabledFeatures     Json
  status              PlanStatus            @default(ACTIVE)
  createdAt           DateTime              @default(now()) @db.DateTime(3)
  updatedAt           DateTime              @updatedAt @db.DateTime(3)
  subscriptions       Subscription[]
  subscriptionHistory SubscriptionHistory[]

  @@unique([code, version])
  @@index([status])
  @@index([code, status, isPublic])
}

model Subscription {
  id                 String                @id @default(uuid()) @db.Char(36)
  organizationId     String                @db.Char(36)
  planId             String                @db.Char(36)
  status             SubscriptionStatus    @default(TRIALING)
  startedAt          DateTime              @default(now()) @db.DateTime(3)
  currentPeriodStart DateTime              @db.DateTime(3)
  currentPeriodEnd   DateTime              @db.DateTime(3)
  canceledAt         DateTime?             @db.DateTime(3)
  cancelAtPeriodEnd  Boolean               @default(false)
  trialEndsAt        DateTime?             @db.DateTime(3)
  endedAt            DateTime?             @db.DateTime(3)
  createdAt          DateTime              @default(now()) @db.DateTime(3)
  updatedAt          DateTime              @updatedAt @db.DateTime(3)
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan               Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  history            SubscriptionHistory[]

  @@index([organizationId, status])
  @@index([organizationId, currentPeriodEnd])
  @@index([planId, status])
}

model SubscriptionHistory {
  id               String             @id @default(uuid()) @db.Char(36)
  organizationId   String             @db.Char(36)
  subscriptionId   String             @db.Char(36)
  planId           String             @db.Char(36)
  planCode         String             @db.VarChar(32)
  planVersion      Int
  status           SubscriptionStatus
  reason           String             @db.VarChar(100)
  limitsSnapshot   Json
  featuresSnapshot Json
  periodStart      DateTime           @db.DateTime(3)
  periodEnd        DateTime           @db.DateTime(3)
  createdAt        DateTime           @default(now()) @db.DateTime(3)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription     Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  plan             Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([subscriptionId, createdAt])
}

model StorageUsage {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @unique @db.Char(36)
  usedBytes      BigInt       @default(0)
  reservedBytes  BigInt       @default(0)
  fileCount      BigInt       @default(0)
  version        Int          @default(0)
  calculatedAt   DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model ResourceCounter {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @unique @db.Char(36)
  cameraCount    Int          @default(0)
  memberCount    Int          @default(0)
  version        Int          @default(0)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model LimitEvent {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @db.Char(36)
  type           String       @db.VarChar(64)
  resource       String       @db.VarChar(32)
  threshold      Int?
  currentValue   BigInt
  limitValue     BigInt
  metadata       Json?
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, resource, createdAt])
  @@index([type, createdAt])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Char(36)
  organizationId String?       @db.Char(36)
  actorUserId    String?       @db.Char(36)
  action         String        @db.VarChar(100)
  entityType     String        @db.VarChar(100)
  entityId       String?       @db.VarChar(191)
  metadata       Json?
  ipAddress      String?       @db.VarChar(45)
  userAgent      String?       @db.VarChar(512)
  createdAt      DateTime      @default(now()) @db.DateTime(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actorUser      User?         @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorUserId, createdAt])
}
