model WorkerHealth {
  name          String    @id @db.VarChar(100)
  status        String    @db.VarChar(16)
  lastStartedAt DateTime? @db.DateTime(3)
  lastSuccessAt DateTime? @db.DateTime(3)
  lastFailureAt DateTime? @db.DateTime(3)
  lastErrorCode String?   @db.VarChar(100)
  durationMs    Int?
  updatedAt     DateTime  @updatedAt @db.DateTime(3)

  @@index([status, updatedAt])
}

model AiConversation {
  id             String            @id @default(uuid()) @db.Char(36)
  organizationId String            @db.Char(36)
  userId         String            @db.Char(36)
  title          String?           @db.VarChar(160)
  createdAt      DateTime          @default(now()) @db.DateTime(3)
  updatedAt      DateTime          @updatedAt @db.DateTime(3)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User              @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  messages       AiMessage[]
  toolExecutions AiToolExecution[]

  @@unique([organizationId, id])
  @@index([organizationId, userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(uuid()) @db.Char(36)
  conversationId String         @db.Char(36)
  role           String         @db.VarChar(16)
  content        String         @db.Text
  createdAt      DateTime       @default(now()) @db.DateTime(3)
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiToolExecution {
  id             String         @id @default(uuid()) @db.Char(36)
  conversationId String         @db.Char(36)
  tool           String         @db.VarChar(80)
  status         String         @db.VarChar(16)
  durationMs     Int
  createdAt      DateTime       @default(now()) @db.DateTime(3)
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AiUsageDay {
  id             String        @id @default(uuid()) @db.Char(36)
  day            DateTime      @db.Date
  scope          String        @db.VarChar(16)
  scopeKey       String        @db.VarChar(80)
  organizationId String?       @db.Char(36)
  userId         String?       @db.Char(36)
  requests       Int           @default(0)
  inputTokens    Int           @default(0)
  outputTokens   Int           @default(0)
  neurons        Float         @default(0)
  updatedAt      DateTime      @updatedAt @db.DateTime(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([day, scopeKey])
  @@index([day, scope])
  @@index([organizationId, day])
  @@index([userId, day])
}
